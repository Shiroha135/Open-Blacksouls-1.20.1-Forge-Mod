  "item.blacksouls.skill_book_invisible.lore.2": "CD:0s",

  "item.blacksouls.skill_book_gunfire": "技能书【枪火击溃】",
  "item.blacksouls.skill_book_gunfire.lore.1": "造成巨额伤害并破坏敌人架势。",
  "item.blacksouls.skill_book_gunfire.lore.2": "CD:10s",

  "item.blacksouls.skill_book_requiem": "魔书【镇魂歌】",
  "item.blacksouls.skill_book_requiem.lore.1": "在一段时间内使自身不会陷入无法战斗状态。",
  "item.blacksouls.skill_book_requiem.lore.2": "CD:90s",

  "item.blacksouls.skill_book_grit": "魔书【咬紧牙关】",
  "item.blacksouls.skill_book_grit.lore.1": "受到致死量的伤害时留下1HP。",
  "item.blacksouls.skill_book_grit.lore.2": "CD:80s",

  "item.blacksouls.skill_book_dodo_run": "技能书【渡渡快跑】",
  "item.blacksouls.skill_book_dodo_run.lore.1": "使用后习得技能：渡渡快跑",
  "item.blacksouls.skill_book_dodo_run.lore.2": "吾辈是真的，真的，没有觉得寂寞哦……？",
  "item.blacksouls.skill_book_dodo_run.lore.3": "所，所以呢，请你不要再悲伤了……",
  "item.blacksouls.skill_book_dodo_run.lore.4": "我啊，§4最喜欢§7你了……",
  "item.blacksouls.skill_book_dodo_run.lore.5": "就算转个三圈也不会忘掉你的……",

  "item.blacksouls.skill_book_soul_arrow": "魔书【魂之矢】",
  "item.blacksouls.skill_book_soul_arrow.lore1": "释放出神圣的魂之矢。",
  "item.blacksouls.skill_book_soul_arrow.lore2": "威力依存于使用者的魔力。",

  "item.blacksouls.skill_book_soul_light": "魔书【魂之光】",
  "item.blacksouls.skill_book_soul_light.lore1": "神圣的灵魂治愈着你。",
  "item.blacksouls.skill_book_soul_light.lore2": "恢复量依存于使用者的魔力。",

  "item.blacksouls.skill_book_soul_radiation": "魔书【魂之放射】",
  "item.blacksouls.skill_book_soul_radiation.lore1": "让敌方全体沐浴在魂之矢当中。",
  "item.blacksouls.skill_book_soul_radiation.lore2": "威力依存于使用者的魔力。",

  "item.blacksouls.skill_book_carthus_blood_curse": "魔书【卡萨斯血咒】",
  "item.blacksouls.skill_book_carthus_blood_curse.lore1": "减少自身HP，恢复自身MP。",

