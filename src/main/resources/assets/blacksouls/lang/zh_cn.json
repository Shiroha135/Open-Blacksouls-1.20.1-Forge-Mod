  "dialogue.blacksouls.noden.first_1": "初次见面，%s先生。\n我是§c诺登§f。在这个图书室担任管理员的职务。",
  "dialogue.blacksouls.noden.first_2": "%s大人。请去搜集魂当做自己的食粮吧。\n曾经是一个鸟兽都能愉快生活的乐园的不思议之国，现在已被狂气与暴力所浸染了",
  "dialogue.blacksouls.noden.first_3": "%s大人是我们重要的客人。\n您要是有什么想要满足的需求，还请您务必吩咐我诺登。",
  "dialogue.blacksouls.noden.second_1": "%s大人。\n在这个国度里，存在着来自昏暗之底的§c四个噩梦§f。",
  "dialogue.blacksouls.noden.second_2": "§c熏烟狂躁的班达斯耐奇\n§e狂鸟贾布加布\n§7尸龙贾巴沃克§f",
  "dialogue.blacksouls.noden.second_3": "以及……\n红城佛理塞尔的暴君，§4心脏女王",
  "dialogue.blacksouls.noden.second_4": "如果您见到她们其中的任一个……\n%s大人，千万注意不要被她们夺走你的魂",
  "dialogue.blacksouls.noden.later_1": "欢迎回来，%s大人。\n您有什么事吗？",
  "dialogue.blacksouls.noden.upgrade_success": "%s大人…。谢谢您",
  "gui.blacksouls.levelup.dialog.welcome": "那么%s大人。请握住我的手。\n我会向您的魂献上祈祷",
  "gui.blacksouls.levelup.dialog.cancel": "您暂且不想了么？",
  "gui.blacksouls.dialogue.exit_message": "出门在外还请您多加小心，%s大人",

  "gui.blacksouls.dialogue.option.upgrade": "升级",
  "gui.blacksouls.dialogue.option.buy_colored_souls": "购买有色魂",
  "gui.blacksouls.dialogue.option.covenant": "誓约",
  "gui.blacksouls.dialogue.option.offer_souls": "献上魂",
  "gui.blacksouls.dialogue.option.make_clock": "请求她制作时计",
  "gui.blacksouls.dialogue.option.kiss": "亲吻她",
  "gui.blacksouls.dialogue.option.seek_service": "寻求侍奉",
  "gui.blacksouls.dialogue.option.fall_in_love": "相爱",
  "gui.blacksouls.dialogue.option.kill": "杀害",
  "gui.blacksouls.dialogue.option.exit": "离开",

  "gui.blacksouls.dialogue.kill_response": "啊……",
  "gui.blacksouls.levelup.dialog.confirm": "魂寄宿到了%s大人的身体中",

  "gui.blacksouls.dialogue.covenant.first_1": "想要和我来缔结誓约…？",
  "gui.blacksouls.dialogue.covenant.first_2": "呵呵，可以哟。\n我诺登，会在暗中为您祈祷",
  "gui.blacksouls.dialogue.covenant.second_1": "誓约的数量没有上限。\n但是当对方被§c杀害§f或§c强奸§f时，与其的羁绊便会断绝，\n誓约也会遭到废弃，还请注意。",
  "gui.blacksouls.dialogue.covenant.second_2": "不过我的灵魂被束缚在了这里，\n无论%s大人对我做什么也没关系就是了……",
  "gui.blacksouls.dialogue.covenant.third_1": "%s大人…？\n您很在意我的耳朵吗…？\n那个……您也可以来试着摸摸哟…？",
  "gui.blacksouls.dialogue.covenant.fourth_1": "我的故乡被大海所包围着，\n海风吹拂，真的是非常舒适呢。",
  "gui.blacksouls.dialogue.covenant.fourth_2": "%s大人。\n什么时候，让您来看看我的泳装吧，呵呵。",
  "gui.blacksouls.dialogue.covenant.fifth_1": "%s大人真是温柔呢…。",
  "gui.blacksouls.dialogue.covenant.fifth_2": "请让我今后都陪伴在您的身边…",
  "gui.blacksouls.dialogue.seek_service_1": "…侍奉么，我明白了",
  "gui.blacksouls.dialogue.seek_service_2": "好…请让我侍奉您……❤",
